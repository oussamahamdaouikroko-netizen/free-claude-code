# Medirdv Central — environment template (placeholders only, never real secrets)
# Copy to .env and fill in. The server reads process env; .env is loaded if present.

# --- Server ---
PORT=8080
HOST=0.0.0.0
# Absolute path to the SQLite file (created on first run). Default: ./data/medirdv-central.sqlite
MEDIRDV_DB_PATH=./data/medirdv-central.sqlite
# Directory for uploaded payment receipts (stored outside the DB). Default: ./data/receipts
MEDIRDV_RECEIPTS_DIR=./data/receipts
# Public base URL of this deployment (used in WhatsApp action links). No trailing slash.
MEDIRDV_PUBLIC_URL=http://localhost:8080
# Display timezone for dates shown to users (storage is always UTC).
MEDIRDV_TIMEZONE=Africa/Algiers

# --- Security ---
# 32+ random bytes, hex or base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt WhatsApp access tokens at rest (AES-256-GCM).
MEDIRDV_ENCRYPTION_KEY=
# Cookie name for admin sessions.
MEDIRDV_SESSION_COOKIE=medirdv_session

# --- Bootstrap administrator (used ONLY when the users table is empty) ---
# Change immediately after first login. Leave empty to skip auto-creation.
MEDIRDV_BOOTSTRAP_ADMIN_EMAIL=admin@medirdv.dz
MEDIRDV_BOOTSTRAP_ADMIN_PASSWORD=

# --- Official Meta WhatsApp Business Platform (Cloud API) ---
# Leave empty to run with WhatsApp Hub DISABLED (click-to-chat fallback only).
# These are platform-level values; each doctor's Phone Number ID + token are
# stored per-doctor (encrypted) after Embedded Signup authorization.
WHATSAPP_CLOUD_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_EMBEDDED_SIGNUP_APP_ID=

# --- Payments ---
# BaridiMob is manual-verification only (no official merchant API is assumed).
# Default recipient shown to patients when a doctor has no custom value.
BARIDIMOB_RECIPIENT_NAME=
BARIDIMOB_RECIPIENT_RIB=
# Service fee (DZD) charged by Medirdv on top of the consultation fee. 0 = none.
MEDIRDV_SERVICE_FEE_DZD=0

# --- Desktop connector ---
# Shared secret used to mint per-clinic API keys (keys are hashed at rest).
MEDIRDV_CONNECTOR_SECRET=
