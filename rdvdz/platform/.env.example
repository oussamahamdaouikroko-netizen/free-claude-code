# ---------------------------------------------------------------------------
# RDV DZ — variables d'environnement (EXEMPLE, aucune valeur réelle)
# Copier en `.env.local` (ou `.env`) et remplir. Ces fichiers sont ignorés par Git.
# Le chargement est automatique au démarrage (src/env.js) : `.env`, `.env.local`,
# puis `.env.<NODE_ENV>`. L'environnement du shell a toujours la priorité.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# --- Base de données -------------------------------------------------------
# Option A (production) : PostgreSQL
# DATABASE_URL=postgres://rdvdz:motdepasse@127.0.0.1:5432/rdvdz
# Option B (développement / tests) : PGlite (PostgreSQL en WASM, aucun serveur)
DB_DRIVER=pglite
PGLITE_DIR=./.data/pglite

# --- Sécurité --------------------------------------------------------------
# Secret de signature (sessions annexes, liens de documents, HMAC appareils).
# Générer avec: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=changez-moi-48-octets-aleatoires
# Cookies sécurisés (obligatoire true en production, derrière HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Durée de validité des liens de téléchargement de documents médicaux
DOCUMENT_LINK_TTL_SECONDS=300

# --- Conformité ------------------------------------------------------------
# Transfert de données hors Algérie : bloqué par défaut (loi 18-07 mod. 25-11).
ALLOW_CROSS_BORDER=false
# Téléconsultation : la partie gratuite (information) est ouverte, l'acte
# clinique PAYANT reste désactivé jusqu'à revue juridique.
TELEMEDICINE_ENABLED=true
TELEMEDICINE_PAID_ENABLED=false
# Portefeuille électronique : désactivé (agrément financier requis).
WALLET_ENABLED=false

# --- Paiements -------------------------------------------------------------
# sandbox (simulé, étiqueté) | chargily (réel) | manual (espèces constatées)
PAYMENTS_PROVIDER=sandbox
PAYMENTS_SANDBOX_ALLOWED=true
CHARGILY_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2
CHARGILY_WEBHOOK_URL=https://api.example.dz/api/v1/webhooks/chargily
PUBLIC_WEB_URL=http://localhost:8080

# --- Notifications ---------------------------------------------------------
# click_to_chat (repli sans coût) | official (WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=click_to_chat
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
SMTP_URL=
SMS_PROVIDER=dev

# --- Stockage des documents médicaux --------------------------------------
# local (disque chiffré AES-256-GCM) | s3 (compatible S3, à configurer)
STORAGE_DRIVER=local
STORAGE_DIR=./.data/documents
STORAGE_ENCRYPTION_KEY=changez-moi-32-octets-aleatoires

# --- Divers ----------------------------------------------------------------
# En développement uniquement : renvoie le code OTP dans la réponse HTTP.
OTP_DEBUG=true
LOG_LEVEL=info
