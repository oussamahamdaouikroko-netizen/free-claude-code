# Medirdv Central — environment configuration (placeholders only)
# Copy to .env and fill in real values. NEVER commit a real .env file.

# --- Server ---
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
DB_PATH=./data/medirdv_central.db
RECEIPTS_DIR=./data/receipts
TIMEZONE=Africa/Algiers

# --- Security (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))") ---
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-another-long-random-string
COOKIE_SECURE=false
# Set COOKIE_SECURE=true behind HTTPS in production.

# --- WhatsApp (official Meta Cloud API) ---
# WHATSAPP_MODE: cloud (real Meta API) | mock (local dev/tests ONLY, logged, never real) | disabled
WHATSAPP_MODE=mock
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE=https://graph.facebook.com

# --- Booking policy ---
DOCTOR_RESPONSE_HOURS=24
BOOKING_LEAD_HOURS=2
DEFAULT_CURRENCY=DZD

# --- Admin bootstrap (used only when the DB is empty) ---
BOOTSTRAP_ADMIN_EMAIL=admin@medirdv.dz
BOOTSTRAP_ADMIN_PASSWORD=admin123
