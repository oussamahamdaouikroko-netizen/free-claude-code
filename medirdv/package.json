{
  "name": "medirdv",
  "version": "2.0.1",
  "description": "MediRDV - offline-first desktop medical suite for single & multi-specialty clinics in Algeria (agenda, multi-department queues, WhatsApp bot, Algerian Nomenclature prescriptions, patients, payments, reports).",
  "main": "src/main/index.js",
  "author": "MediRDV",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "demo": "node demo/server.js",
    "test": "node tests/run.js",
    "rebuild": "electron-builder install-app-deps",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "test:watch": "node --test --watch --test-concurrency=1 tests/",
    "dist:demo": "electron-builder --win --config electron-builder.demo.yml"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.3"
  }
}
