"""HTTP layer: REST API router + static SPA serving (stdlib only).

Every route enforces RBAC server-side. Sessions are cookie-based with
hashed tokens at rest and a CSRF token required on mutations.
"""
from __future__ import annotations

import base64
import json
import logging
import re
import secrets
import sqlite3
import threading
import time
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

from . import db as dbmod
from . import services
from .auth import AuthError, Principal, require
from .config import Config
from .security import (RateLimiter, clean_text, encrypt_text, hash_password,
                       hash_token, new_session_token, valid_email,
                       verify_password, verify_webhook_signature)
from .whatsapp import WhatsAppSender, account_status, process_webhook

log = logging.getLogger("medirdv.server")
BASE_DIR = Path(__file__).resolve().parent.parent
STATIC_DIR = BASE_DIR / "static"
SESSION_COOKIE = "medirdv_session"


def init_extra_tables(conn: sqlite3.Connection) -> None:
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS sessions (
          token_hash TEXT PRIMARY KEY,
          user_id    INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
          csrf_token TEXT NOT NULL,
          created_at TEXT NOT NULL DEFAULT (datetime('now')),
          expires_at TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS payment_methods (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          name TEXT NOT NULL UNIQUE,
          active INTEGER NOT NULL DEFAULT 1
        );
        """
    )
    for name in ("baridimob", "cash", "baridi_pay", "cib", "edahabia"):
        conn.execute("INSERT OR IGNORE INTO payment_methods (name, active) VALUES (?, 1)", (name,))
    conn.commit()


def bootstrap(conn: sqlite3.Connection, cfg: Config) -> None:
    init_extra_tables(conn)
    row = conn.execute("SELECT COUNT(*) AS n FROM users").fetchone()
    if row["n"] == 0:
        conn.execute(
            "INSERT INTO users (email, password_hash, role, full_name) VALUES (?, ?, 'super_admin', ?)",
            (cfg.bootstrap_admin_email, hash_password(cfg.bootstrap_admin_password),
             "Platform Administrator"),
        )
        conn.commit()
        log.info("Bootstrap super admin created: %s", cfg.bootstrap_admin_email)
    for fr, ar in [("Médecine générale", "TB General"),
                   ("Dentaire", "Dental"),
                   ("Cardiologie", "Cardiology"),
                   ("Pédiatrie", "Pediatrics"),
                   ("Gynécologie", "Gynecology"),
                   ("Ophtalmologie", "Ophthalmology"),
                   ("Orthopédie", "Orthopedics"),
                   ("Dermatologie", "Dermatology")]:
        conn.execute("INSERT OR IGNORE INTO specialties (name_fr, name_ar) VALUES (?, ?)", (fr, ar))
    conn.commit()


class App:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        cfg.ensure_dirs()
        self.conn = dbmod.connect(cfg.db_path)
        dbmod.migrate(self.conn)
        bootstrap(self.conn, cfg)
        self.limiter = RateLimiter(capacity=300, refill_per_minute=300)
        self._start_expiry_sweep()

    def _start_expiry_sweep(self) -> None:
        def loop() -> None:
            while True:
                time.sleep(300)
                try:
                    services.expire_overdue(self.conn)
                except Exception:  # noqa: BLE001
                    log.exception("expiry sweep failed")
        threading.Thread(target=loop, daemon=True).start()

    # ------------------------------------------------------------ sessions
    def login(self, email: str, password: str) -> tuple[str, str, Principal]:
        user = self.conn.execute("SELECT * FROM users WHERE email = ?", (email,)).fetchone()
        if user is None or user["status"] != "active" or not verify_password(password, user["password_hash"]):
            raise AuthError("Invalid credentials", 401)
        raw, token_hash = new_session_token()
        csrf = secrets.token_urlsafe(24)
        expires = time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(time.time() + 12 * 3600))
        self.conn.execute(
            "INSERT INTO sessions (token_hash, user_id, csrf_token, expires_at) VALUES (?, ?, ?, ?)",
            (token_hash, user["id"], csrf, expires),
        )
        self.conn.commit()
        return raw, csrf, self._principal(user)

    def _principal(self, user: sqlite3.Row) -> Principal:
        doctor_id = None
        if user["role"] == "doctor":
            row = self.conn.execute("SELECT id FROM doctors WHERE user_id = ?", (user["id"],)).fetchone()
            doctor_id = row["id"] if row else None
        return Principal(user_id=user["id"], email=user["email"], role=user["role"],
                         full_name=user["full_name"], doctor_id=doctor_id)

    def principal_from_token(self, raw: str | None) -> tuple[Principal | None, str | None]:
        if not raw:
            return None, None
        row = self.conn.execute(
            "SELECT s.*, u.* FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token_hash = ?",
            (hash_token(raw),),
        ).fetchone()
        if row is None:
            return None, None
        if row["expires_at"] < time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime()):
            return None, None
        user = self.conn.execute("SELECT * FROM users WHERE id = ?", (row["user_id"],)).fetchone()
        return self._principal(user), row["csrf_token"]

    def logout(self, raw: str | None) -> None:
        if raw:
            self.conn.execute("DELETE FROM sessions WHERE token_hash = ?", (hash_token(raw),))
            self.conn.commit()

    # ------------------------------------------------------------ handler factory
    def make_handler(app: App):
        class Handler(BaseHTTPRequestHandler):
            server_version = "MedirdvCentral/1.0"

            # ------------------------------------------------------ plumbing
            def log_message(self, fmt, *args):  # quieter logs
                log.debug("%s - %s", self.address_string(), fmt % args)

            def _send_json(self, status: int, obj: dict) -> None:
                body = json.dumps(obj, ensure_ascii=False).encode()
                self.send_response(status)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def _read_json(self) -> dict:
                length = int(self.headers.get("Content-Length", 0) or 0)
                if length <= 0 or length > 2_000_000:
                    return {}
                try:
                    return json.loads(self.rfile.read(length).decode() or "{}")
                except (ValueError, UnicodeDecodeError):
                    return {}

            def _cookies(self) -> dict:
                out = {}
                for part in (self.headers.get("Cookie", "") or "").split(";"):
                    if "=" in part:
                        k, _, v = part.partition("=")
                        out[k.strip()] = v.strip()
                return out

            def _auth(self) -> tuple[Principal | None, str | None]:
                return app.principal_from_token(self._cookies().get(SESSION_COOKIE))

            def _check_csrf(self, csrf_expected: str | None) -> None:
                if csrf_expected is None:
                    return
                if self.headers.get("X-CSRF-Token", "") != csrf_expected:
                    raise AuthError("CSRF token missing or invalid", 403)

            def _client_ip(self) -> str:
                return self.headers.get("X-Forwarded-For", self.client_address[0]).split(",")[0].strip()

            # ------------------------------------------------------ dispatch
            def do_GET(self):
                self._dispatch("GET")

            def do_POST(self):
                self._dispatch("POST")

            def do_PUT(self):
                self._dispatch("PUT")

            def do_DELETE(self):
                self._dispatch("DELETE")

            def _dispatch(self, method: str) -> None:
                parsed = urlparse(self.path)
                path = parsed.path.rstrip("/") or "/"
                query = {k: v[0] for k, v in parse_qs(parsed.query).items()}
                if not app.limiter.allow(f"{self._client_ip()}:{path}"):
                    return self._send_json(429, {"error": "Too many requests"})
                try:
                    status, obj = self._route(method, path, query)
                    if obj is None and status == 200:
                        return self._serve_static(path)
                    return self._send_json(status, obj)
                except AuthError as exc:
                    return self._send_json(exc.status, {"error": str(exc)})
                except services.ServiceError as exc:
                    return self._send_json(exc.status, {"error": str(exc)})
                except Exception as exc:  # noqa: BLE001 — generic errors, no internals leaked
                    log.exception("unhandled error on %s %s", method, path)
                    return self._send_json(500, {"error": "Internal server error"})

            def _serve_static(self, path: str) -> None:
                rel = path.lstrip("/") or "index.html"
                target = (STATIC_DIR / rel).resolve()
                if not str(target).startswith(str(STATIC_DIR.resolve())) or not target.is_file():
                    target = STATIC_DIR / "index.html"
                ctype = {".html": "text/html; charset=utf-8", ".css": "text/css; charset=utf-8",
                         ".js": "text/javascript; charset=utf-8"}.get(target.suffix, "application/octet-stream")
                data = target.read_bytes()
                self.send_response(200)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

            # ------------------------------------------------------ routes
            def _route(self, method: str, path: str, query: dict) -> tuple[int, dict | None]:
                conn = app.conn
                cfg = app.cfg
                principal, csrf = self._auth()
                body = self._read_json() if method in ("POST", "PUT") else {}

                # ---- health
                if path == "/api/v1/health":
                    return 200, {"status": "ok", "whatsapp_mode": cfg.whatsapp_mode,
                                 "time": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}

                # ---- auth
                if path == "/api/v1/auth/login" and method == "POST":
                    email = clean_text(body.get("email"), 200).lower()
                    if not valid_email(email):
                        raise AuthError("Invalid credentials", 401)
                    raw, csrf_token, princ = app.login(email, str(body.get("password", "")))
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json; charset=utf-8")
                    self.send_header("Set-Cookie",
                                     f"{SESSION_COOKIE}={raw}; HttpOnly; Path=/; SameSite=Lax"
                                     + ("; Secure" if cfg.cookie_secure else ""))
                    payload = json.dumps({"user": {"email": princ.email, "role": princ.role,
                                                  "full_name": princ.full_name,
                                                  "doctor_id": princ.doctor_id},
                                        "csrf_token": csrf_token}).encode()
                    self.send_header("Content-Length", str(len(payload)))
                    self.end_headers()
                    self.wfile.write(payload)
                    return 200, None
                if path == "/api/v1/auth/logout" and method == "POST":
                    app.logout(self._cookies().get(SESSION_COOKIE))
                    return 200, {"ok": True}
                if path == "/api/v1/auth/me":
                    if principal is None:
                        raise AuthError("Authentication required", 401)
                    return 200, {"user": {"email": principal.email, "role": principal.role,
                                          "full_name": principal.full_name,
                                          "doctor_id": principal.doctor_id},
                                 "csrf_token": csrf}

                # ---- WhatsApp webhook (public, signature-verified)
                if path == "/webhooks/whatsapp":
                    if method == "GET":
                        if query.get("hub.mode") == "subscribe" and \
                                query.get("hub.verify_token") == cfg.whatsapp_verify_token:
                            return 200, {"challenge": query.get("hub.challenge", "")}
                        raise AuthError("Verification failed", 403)
                    if method == "POST":
                        length = int(self.headers.get("Content-Length", 0) or 0)
                        raw_body = self.rfile.read(length) if length else b"{}"
                        if not verify_webhook_signature(cfg.whatsapp_app_secret, raw_body,
                                                        self.headers.get("X-Hub-Signature-256", "")):
                            raise AuthError("Invalid webhook signature", 403)
                        result = process_webhook(conn, cfg, json.loads(raw_body.decode() or "{}"))
                        return 200, result

                # ---- public: specialties / doctors / availability
                if path == "/api/v1/public/specialties":
                    return 200, {"specialties": [dict(r) for r in conn.execute(
                        "SELECT * FROM specialties ORDER BY name_fr").fetchall()]}
                if path == "/api/v1/public/doctors" and method == "GET":
                    return 200, {"doctors": services.search_doctors(
                        conn, query.get("q", ""), query.get("specialty", ""),
                        query.get("wilaya", ""), query.get("clinic", ""))}
                m = re.match(r"^/api/v1/public/doctors/(\d+)$", path)
                if m and method == "GET":
                    doc = services.get_doctor(conn, int(m.group(1)))
                    if doc is None or doc["status"] != "active":
                        raise services.ServiceError("doctor not found", 404)
                    doc["whatsapp"] = account_status(conn, doc["id"])
                    return 200, {"doctor": doc}
                m = re.match(r"^/api/v1/public/doctors/(\d+)/availability$", path)
                if m and method == "GET":
                    doctor_id = int(m.group(1))
                    clinic_id = int(query["clinic_id"]) if query.get("clinic_id") else None
                    date_str = query.get("date", "")
                    lead = int(dbmod.get_setting(conn, "booking_lead_hours", str(cfg.booking_lead_hours)))
                    return 200, {"slots": services.available_slots(conn, doctor_id, clinic_id, date_str, lead)}

                # ---- public: bookings
                if path == "/api/v1/public/bookings" and method == "POST":
                    idem = self.headers.get("Idempotency-Key") or body.get("idempotency_key")
                    result = services.create_booking(conn, body, idem, cfg)
                    appt = result["appointment"]
                    # Notify the doctor via their own WhatsApp account (or fallback).
                    row = conn.execute("SELECT * FROM appointments WHERE id = ?", (appt["id"],)).fetchone()
                    clinic = conn.execute("SELECT name FROM clinics WHERE id = ?",
                                          (appt["clinic_id"],)).fetchone() if appt["clinic_id"] else None
                    from . import i18n
                    msg = i18n.t("booking_request", "fr", patient=appt["patient_name"], ref=appt["ref"],
                                 date=appt["date"], time=appt["time"],
                                 clinic=clinic["name"] if clinic else "—")
                    wa = WhatsAppSender(conn, cfg).send_booking_request(row, msg)
                    return 201, {"booking": appt, "duplicate": result["duplicate"], "whatsapp": wa}
                if path == "/api/v1/public/bookings/track" and method == "GET":
                    tracked = services.track_booking(conn, query.get("ref", ""), query.get("phone", ""))
                    if tracked is None:
                        raise services.ServiceError("booking not found", 404)
                    return 200, {"booking": tracked}
                m = re.match(r"^/api/v1/public/bookings([^/]+)/payment$", path)
                if m and method == "POST":
                    return 200, services.submit_payment(
                        conn, m.group(1), str(body.get("phone", "")),
                        str(body.get("txn_ref", "")), body.get("receipt_path"), "patient")
                m = re.match(r"^/api/v1/public/bookings([^/]+)/receipt$", path)
                if method == "POST":
                    return self._upload_receipt(m.group(1), body)
                m = re.match(r"^/api/v1/public/bookings([^/]+)/cancel$", path)
                if method == "POST":
                    return 200, services.cancel_booking(conn, m.group(1), str(body.get("phone", "")), "patient")
                m = re.match(r"^/api/v1/public/bookings([^/]+)/click-to-chat$", path)
                if method == "GET":
                    appt = conn.execute("SELECT * FROM appointments WHERE ref = ?", (m.group(1),)).fetchone()
                    if appt is None:
                        raise services.ServiceError("booking not found", 404)
                    from .whatsapp import click_to_chat_url
                    doctor = conn.execute("SELECT whatsapp_number FROM doctors WHERE id = ?", (appt["doctor_id"],)).fetchone()
                    text = f"Bonjour, je souhaite confirmer mon rendez-vous {appt['ref']} le {appt['date']} à {appt['time']}."
                    return 200, {"url": click_to_chat_url(doctor["whatsapp_number"] or "", text),
                                 "mode": "click_to_chat"}

                # ---- admin
                if path.startswith("/api/v1/admin/"):
                    return self._admin_routes(method, path, query, body, principal)
                # ---- doctor portal
                if path.startswith("/api/v1/doctor/"):
                    return self._doctor_routes(method, path, query, body, principal)
                # ---- connector
                if path.startswith("/api/v1/connector/"):
                    return self._connector_routes(method, path, query, body)

                return 404, {"error": "Not found"}

            # ------------------------------------------------------ admin routes
            def _admin_routes(self, method, path, query, body, principal) -> tuple[int, dict]:
                conn = app.conn
                if path == "/api/v1/admin/stats":
                    require(principal, "dashboard.view")
                    services.expire_overdue(conn)
                    return 200, services.dashboard_stats(conn)
                if path == "/api/v1/admin/doctors" and method == "GET":
                    require(principal, "doctors.manage")
                    rows = conn.execute("SELECT * FROM doctors ORDER BY id").fetchall()
                    return 200, {"doctors": [dict(r) for r in rows]}
                if path == "/api/v1/admin/doctors" and method == "POST":
                    require(principal, "doctors.manage")
                    return 201, {"id": services.create_doctor(conn, body, principal.email)}
                m = re.match(r"^/api/v1/admin/doctors/(\d+)$", path)
                if m and method == "PUT":
                    require(principal, "doctors.manage")
                    services.update_doctor(conn, int(m.group(1)), body, principal.email)
                    return 200, {"ok": True}
                m = re.match(r"^/api/v1/admin/doctors/(\d+)/status$", path)
                if m and method == "POST":
                    require(principal, "doctors.manage")
                    services.set_doctor_status(conn, int(m.group(1)), str(body.get("status", "")), principal.email)
                    return 200, {"ok": True}
                m = re.match(r"^/api/v1/admin/doctors/(\d+)/clinics/(\d+)$", path)
                if m and method == "POST":
                    require(principal, "clinics.manage")
                    services.link_doctor_clinic(conn, int(m.group(1)), int(m.group(2)), body, principal.email)
                    return 200, {"ok": True}
                if path == "/api/v1/admin/clinics" and method == "GET":
                    require(principal, "clinics.manage")
                    return 200, {"clinics": [dict(r) for r in conn.execute("SELECT * FROM clinics ORDER BY id").fetchall()]}
                if path == "/api/v1/admin/clinics" and method == "POST":
                    require(principal, "clinics.manage")
                    return 201, {"id": services.create_clinic(conn, body, principal.email)}
                if path == "/api/v1/admin/appointments" and method == "GET":
                    require(principal, "appointments.view_all")
                    sql = ("SELECT a.*, d.full_name AS doctor_name FROM appointments a "
                           "JOIN doctors d ON d.id = a.doctor_id WHERE 1=1")
                    params: list = []
                    if query.get("status"):
                        sql += " AND a.status = ?"
                        params.append(query["status"])
                    if query.get("doctor_id"):
                        sql += " AND a.doctor_id = ?"
                        params.append(int(query["doctor_id"]))
                    sql += " ORDER BY a.id DESC LIMIT 200"
                    return 200, {"appointments": [dict(r) for r in conn.execute(sql, params).fetchall()]}
                if path == "/api/v1/admin/payments" and method == "GET":
                    require(principal, "payments.view")
                    sql = ("SELECT p.*, a.ref AS booking_ref, d.full_name AS doctor_name "
                           "FROM payments p JOIN appointments a ON a.id = p.appointment_id "
                           "JOIN doctors d ON d.id = a.doctor_id WHERE 1=1")
                    params = []
                    if query.get("status"):
                        sql += " AND p.status = ?"
                        params.append(query["status"])
                    if query.get("ref"):
                        sql += " AND a.ref = ?"
                        params.append(query["ref"])
                    sql += " ORDER BY p.id DESC LIMIT 200"
                    return 200, {"payments": [dict(r) for r in conn.execute(sql, params).fetchall()]}
                m = re.match(r"^/api/v1/admin/payments/(\d+)/verify$", path)
                if m and method == "POST":
                    require(principal, "payments.verify")
                    return 200, services.verify_payment(
                        conn, int(m.group(1)), str(body.get("decision", "")),
                        str(body.get("notes", "")), principal.email, principal.user_id)
                m = re.match(r"^/api/v1/admin/payments/(\d+)/refund$", path)
                if method == "POST":
                    require(principal, "payments.refund")
                    return 200, services.refund_payment(conn, int(m.group(1)), str(body.get("notes", "")), principal.email)
                if path == "/api/v1/admin/whatsapp/accounts" and method == "GET":
                    require(principal, "whatsapp.manage")
                    rows = conn.execute(
                        "SELECT w.*, d.full_name AS doctor_name FROM whatsapp_accounts w "
                        "JOIN doctors d ON d.id = w.doctor_id ORDER BY w.id").fetchall()
                    return 200, {"accounts": [dict(r) for r in rows]}
                if path == "/api/v1/admin/whatsapp/accounts" and method == "POST":
                    require(principal, "whatsapp.manage")
                    doctor_id = int(body.get("doctor_id") or 0)
                    mode = body.get("mode", "cloud")
                    if mode not in ("cloud", "click_to_chat"):
                        raise services.ServiceError("invalid mode")
                    token_enc = encrypt_text(str(body.get("access_token", "")), app.cfg.encryption_key) \
                        if body.get("access_token") else None
                    conn.execute(
                        "INSERT INTO whatsapp_accounts (doctor_id, mode, waba_id, phone_number_id, display_number, access_token_enc, status) "
                        "VALUES (?, ?, ?, ?, ?, ?, ?) ON CONFLICT(doctor_id) DO UPDATE SET mode=excluded.mode, "
                        "waba_id=excluded.waba_id, phone_number_id=excluded.phone_number_id, "
                        "display_number=excluded.display_number, access_token_enc=excluded.access_token_enc, "
                        "status=excluded.status, updated_at=datetime('now')",
                        (doctor_id, mode, clean_text(body.get("waba_id"), 100),
                         clean_text(body.get("phone_number_id"), 100),
                         clean_text(body.get("display_number"), 40), token_enc,
                         "connected" if mode == "cloud" else "connected"),
                    )
                    conn.commit()
                    dbmod.audit(conn, principal.email, "whatsapp.connect", "doctor", doctor_id, mode)
                    return 201, {"ok": True}
                m = re.match(r"^/api/v1/admin/whatsapp/accounts/(\d+)/disconnect$", path)
                if m and method == "POST":
                    require(principal, "whatsapp.manage")
                    conn.execute("UPDATE whatsapp_accounts SET status = 'disconnected' WHERE doctor_id = ?",
                                 (int(m.group(1)),))
                    conn.commit()
                    dbmod.audit(conn, principal.email, "whatsapp.disconnect", "doctor", m.group(1))
                    return 200, {"ok": True}
                if path == "/api/v1/admin/whatsapp/messages" and method == "GET":
                    require(principal, "whatsapp.manage")
                    sql = ("SELECT m.*, a.ref AS booking_ref FROM whatsapp_messages m "
                           "LEFT JOIN appointments a ON a.id = m.appointment_id WHERE 1=1")
                    params = []
                    if query.get("doctor_id"):
                        sql += " AND m.doctor_id = ?"
                        params.append(int(query["doctor_id"]))
                    if query.get("ref"):
                        sql += " AND a.ref = ?"
                        params.append(query["ref"])
                    sql += " ORDER BY m.id DESC LIMIT 200"
                    return 200, {"messages": [dict(r) for r in conn.execute(sql, params).fetchall()]}
                m = re.match(r"^/api/v1/admin/whatsapp/messages/(\d+)/retry$", path)
                if m and method == "POST":
                    require(principal, "whatsapp.manage")
                    msg = conn.execute("SELECT * FROM whatsapp_messages WHERE id = ?", (int(m.group(1)),)).fetchone()
                    if msg is None or msg["status"] != "failed":
                        raise services.ServiceError("only failed messages can be retried", 409)
                    appt = conn.execute("SELECT * FROM appointments WHERE id = ?", (msg["appointment_id"],)).fetchone()
                    if appt is None:
                        raise services.ServiceError("booking not found", 404)
                    result = WhatsAppSender(conn, app.cfg).send_booking_request(appt, msg["body"])
                    return 200, {"retry": result}
                if path == "/api/v1/admin/patients" and method == "GET":
                    require(principal, "patients.view")
                    return 200, {"patients": [dict(r) for r in conn.execute(
                        "SELECT * FROM patients ORDER BY id DESC LIMIT 200").fetchall()]}
                if path == "/api/v1/admin/users" and method == "GET":
                    require(principal, "users.manage")
                    return 200, {"users": [dict(r) for r in conn.execute(
                        "SELECT id, email, role, full_name, status, created_at FROM users ORDER BY id").fetchall()]}
                if path == "/api/v1/admin/users" and method == "POST":
                    require(principal, "users.manage")
                    email = clean_text(body.get("email"), 200).lower()
                    role = body.get("role", "admin")
                    if not valid_email(email) or role not in ("super_admin", "admin", "payment_verifier",
                                                               "support_agent", "doctor", "patient"):
                        raise services.ServiceError("invalid email or role")
                    try:
                        cur = conn.execute(
                            "INSERT INTO users (email, password_hash, role, full_name) VALUES (?, ?, ?, ?)",
                            (email, hash_password(str(body.get("password", "ChangeMe123!"))), role,
                             clean_text(body.get("full_name"), 200)),
                        )
                        conn.commit()
                    except sqlite3.IntegrityError as exc:
                        raise services.ServiceError("email already exists", 409) from exc
                    dbmod.audit(conn, principal.email, "user.create", "user", cur.lastrowid, email)
                    return 201, {"id": cur.lastrowid}
                if path == "/api/v1/admin/settings" and method == "GET":
                    require(principal, "settings.manage")
                    return 200, {"settings": {r["key"]: r["value"] for r in conn.execute(
                        "SELECT * FROM system_settings").fetchall()}}
                if path == "/api/v1/admin/settings" and method == "POST":
                    require(principal, "settings.manage")
                    for key, value in (body.get("settings") or {}).items():
                        dbmod.set_setting(conn, clean_text(key, 100), clean_text(value, 2000))
                    return 200, {"ok": True}
                if path == "/api/v1/admin/audit" and method == "GET":
                    require(principal, "audit.view")
                    return 200, {"audit": [dict(r) for r in conn.execute(
                        "SELECT * FROM audit_logs ORDER BY id DESC LIMIT 200").fetchall()]}
                if path == "/api/v1/admin/monitoring" and method == "GET":
                    require(principal, "dashboard.view")
                    return 200, {
                        "whatsapp": [dict(r) for r in conn.execute(
                            "SELECT status, COUNT(*) AS n FROM whatsapp_accounts GROUP BY status").fetchall()],
                        "failed_messages": conn.execute(
                            "SELECT COUNT(*) AS n FROM whatsapp_messages WHERE status = 'failed'").fetchone()["n"],
                        "webhook_events": conn.execute(
                            "SELECT COUNT(*) AS n FROM whatsapp_webhook_events").fetchone()["n"],
                        "unprocessed_webhooks": conn.execute(
                            "SELECT COUNT(*) AS n FROM whatsapp_webhook_events WHERE processed = 0").fetchone()["n"],
                        "sync_failed": conn.execute(
                            "SELECT COUNT(*) AS n FROM sync_queue WHERE status = 'failed'").fetchone()["n"],
                        "integration_logs": [dict(r) for r in conn.execute(
                            "SELECT * FROM integration_logs ORDER BY id DESC LIMIT 20").fetchall()],
                    }
                raise services.ServiceError("Not found", 404)

            # ------------------------------------------------------ doctor routes
            def _doctor_routes(self, method, path, query, body, principal) -> tuple[int, dict]:
                conn = app.conn
                require(principal, "doctor.own")
                if principal.doctor_id is None:
                    raise AuthError("Doctor profile not linked", 403)
                did = principal.doctor_id
                if path == "/api/v1/doctor/me":
                    doc = services.get_doctor(conn, did)
                    doc["whatsapp"] = account_status(conn, did)
                    return 200, {"doctor": doc}
                if path == "/api/v1/doctor/appointments" and method == "GET":
                    rows = conn.execute(
                        "SELECT * FROM appointments WHERE doctor_id = ? ORDER BY date, time",
                        (did,)).fetchall()
                    return 200, {"appointments": [dict(r) for r in rows]}
                m = re.match(r"^/api/v1/doctor/appointments/(\d+)/respond$", path)
                if m and method == "POST":
                    return 200, services.doctor_respond(
                        conn, did, int(m.group(1)), str(body.get("action", "")), principal.email)
                if path == "/api/v1/doctor/availability" and method == "POST":
                    clinic_id = int(body.get("clinic_id") or 0)
                    conn.execute(
                        "INSERT INTO blocked_dates (doctor_id, clinic_id, date, reason) VALUES (?, ?, ?, ?)",
                        (did, clinic_id or None, clean_text(body.get("date"), 10),
                         clean_text(body.get("reason"), 300)),
                    )
                    conn.commit()
                    return 201, {"ok": True}
                raise services.ServiceError("Not found", 404)

            # ------------------------------------------------------ connector routes
            def _connector_routes(self, method, path, query, body) -> tuple[int, dict]:
                """Desktop sync API (Part 7). Device token auth, offline outbox.
                """
                conn = app.conn
                if path == "/api/v1/connector/register" and method == "POST":
                    doctor_id = int(body.get("doctor_id") or 0)
                    device_id = clean_text(body.get("device_id"), 100)
                    if not device_id:
                        raise services.ServiceError("device_id required")
                    token = secrets.token_urlsafe(32)
                    conn.execute(
                        "INSERT INTO device_connections (doctor_id, device_id, token_hash, app_kind) "
                        "VALUES (?, ?, ?, ?) ON CONFLICT(device_id) DO UPDATE SET token_hash=excluded.token_hash, "
                        "status='active', last_seen=datetime('now')",
                        (doctor_id, device_id, hash_token(token), clean_text(body.get("app_kind", "medirdv"), 40)),
                    )
                    conn.commit()
                    dbmod.audit(conn, "connector", "device.register", "doctor", doctor_id, device_id)
                    return 201, {"device_id": device_id, "token": token}
                device_id = self.headers.get("X-Device-Id", "")
                token = self.headers.get("X-Device-Token", "")
                device = conn.execute(
                    "SELECT * FROM device_connections WHERE device_id = ? AND token_hash = ? AND status = 'active'",
                    (device_id, hash_token(token)),
                ).fetchone()
                if device is None:
                    raise AuthError("Invalid device credentials", 401)
                conn.execute("UPDATE device_connections SET last_seen = datetime('now') WHERE device_id = ?",
                             (device_id,))
                conn.commit()
                if path == "/api/v1/connector/sync/pull" and method == "GET":
                    rows = conn.execute(
                        "SELECT * FROM sync_queue WHERE device_id = ? AND status = 'pending' ORDER BY id LIMIT 100",
                        (device_id,)).fetchall()
                    return 200, {"items": [dict(r) for r in rows]}
                if path == "/api/v1/connector/sync/ack" and method == "POST":
                    ids = body.get("ids") or []
                    conn.execute(
                        f"UPDATE sync_queue SET status = 'acked' WHERE device_id = ? AND id IN ({','.join('?' * len(ids))})",
                        [device_id, *ids],
                    )
                    conn.commit()
                    return 200, {"ok": True}
                if path == "/api/v1/connector/sync/push" and method == "POST":
                    kind = clean_text(body.get("kind"), 100)
                    payload = json.dumps(body.get("payload") or {})
                    conn.execute(
                        "INSERT INTO sync_queue (device_id, kind, payload, status) VALUES (?, ?, ?, 'pending')",
                        (device_id, kind, payload),
                    )
                    conn.execute(
                        "INSERT INTO integration_logs (kind, detail) VALUES ('connector_push', ?)",
                        (f"{device_id}:{kind}",),
                    )
                    conn.commit()
                    return 201, {"ok": True}
                if path == "/api/v1/connector/heartbeat" and method == "POST":
                    return 200, {"ok": True, "doctor_id": device["doctor_id"]}
                raise services.ServiceError("Not found", 404)

        return Handler  # <-- FIXED: return the Handler class


# ------------------------------------------------------------ server creation
def create_server(cfg: Config) -> ThreadingHTTPServer:
    app = App(cfg)
    return ThreadingHTTPServer((cfg.host, cfg.port), app.make_handler(app))
